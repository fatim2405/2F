{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash ops/run-tests.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./ops/.env.docker)",
      "Read(./ops/.env.local)",
      "Read(./ops/.env.prod)",
      "Read(./**/.env)",
      "Edit(./packages/money/**)",
      "Write(./packages/money/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
