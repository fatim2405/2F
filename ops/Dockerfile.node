# Image for api, reporting, migrate and seed. Full install inside the image so
# native modules (argon2, sharp) are built for Linux, not copied from the host.
# Node 22: Node 20 is past end of life, and its test runner can't expand the
# quoted "src/**/*.test.ts" globs the workspace test scripts use.
FROM node:22
WORKDIR /app
COPY . .
RUN npm ci
