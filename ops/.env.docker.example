# Template for ops/.env.docker. Copy it to ops/.env.docker and fill in the
# real values there. ops/.env.docker is gitignored: never commit it.
#
# Local docker-compose environment — sandbox/dev only. Do not point this
# compose file at production infrastructure.
#
# NODE_ENV=production so local behaviour matches the hosted box (secure
# cookies, https-only webhook URLs). If cookies don't stick on plain http
# localhost, that's why. — MK
NODE_ENV=production
PORT=3000

# Acquirer sandbox callback signing secret. Ask the acquirer integration
# owner for the current value. It is still a secret: anyone holding it can
# forge acquirer callbacks to this stack.
ACQUIRER_CALLBACK_SIGNING_SECRET=replace_with_sandbox_acquirer_secret

# Shared by api and settlement; the settlement daemon won't start without it,
# and neither will the api under NODE_ENV=production. Generate your own:
#   openssl rand -hex 24
SETTLEMENT_INTERNAL_TOKEN=replace_with_generated_token

# Encrypts stored webhook signing secrets. Must base64-decode to exactly 32
# bytes. Required under NODE_ENV=production. Generate your own:
#   openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=replace_with_generated_key

# Browser origins allowed to call the api (CORS), comma-separated. Leave unset
# outside production to allow the local sites (http://localhost:5173, :5174).
# CORS_ALLOWED_ORIGINS=https://app.example,https://admin.example
