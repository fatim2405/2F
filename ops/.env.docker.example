# Template for ops/.env.docker. Copy it to ops/.env.docker and fill in the
# real values there. ops/.env.docker is gitignored: never commit it.
#
# Local docker-compose environment — sandbox/dev only. Do not point this
# compose file at production infrastructure.
#
# NODE_ENV=production so local behaviour matches the hosted box (secure
# cookies, https-only webhook URLs). If cookies don't stick on plain http
# localhost, that's why. — MK
NODE_ENV=production
PORT=3000

# Acquirer sandbox callback signing secret. Ask the acquirer integration
# owner for the current value. It is still a secret: anyone holding it can
# forge acquirer callbacks to this stack.
ACQUIRER_CALLBACK_SIGNING_SECRET=replace_with_sandbox_acquirer_secret
