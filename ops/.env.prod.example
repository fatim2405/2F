# Copy to ops/.env.prod and fill in. Never commit ops/.env.prod.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Public hostnames (DNS A records pointing at the server)
DOMAIN=pay.example.com
ADMIN_DOMAIN=admin.pay.example.com

# Database
POSTGRES_PASSWORD=change-me

# Shared between the API and the settlement service
SETTLEMENT_INTERNAL_TOKEN=change-me
# 32 random bytes, base64: encrypts webhook signing secrets at rest
WEBHOOK_SECRET_ENCRYPTION_KEY=change-me
# Must match the value configured in the acquirer's portal
ACQUIRER_CALLBACK_SIGNING_SECRET=change-me
