# Builds the merchant site (checkout + dashboard) and the admin console as
# static files and serves them with Caddy, which also terminates TLS and
# proxies /v1/* to the API on the same origin (first-party cookies, no CORS).
FROM node:22 AS build
WORKDIR /app
COPY . .
RUN npm ci
# Empty base URL = same origin: the browser calls /v1/... on the site it is on.
RUN VITE_API_BASE_URL="" npm run build --workspace apps/web \
 && VITE_ADMIN_API_BASE_URL="" npm run build --workspace apps/admin

FROM caddy:2.8-alpine
COPY --from=build /app/apps/web/dist /srv/web
COPY --from=build /app/apps/admin/dist /srv/admin
COPY ops/Caddyfile /etc/caddy/Caddyfile
